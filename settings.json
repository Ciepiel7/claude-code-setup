{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BU_CDP_URL": "http://127.0.0.1:9333"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Edit(*)",
      "Write(*)",
      "Bash(npm *)",
      "Bash(npx shadcn*)",
      "Bash(npx next*)",
      "Bash(npx prisma*)",
      "Bash(npx chrome-devtools-mcp*)",
      "Bash(node *)",
      "Bash(composer *)",
      "Bash(wp *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(uv *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(pip-audit *)",
      "Bash(safety *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "WebSearch",
      "Agent(*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~*)",
      "Edit(.env*)",
      "Write(.env*)",
      "Edit(*.pem)",
      "Write(*.pem)",
      "Edit(*.key)",
      "Write(*.key)",
      "Edit(*credentials*)",
      "Write(*credentials*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/doc-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/session-banner.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/prune-worktree-sessions.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/prune-worktree-sessions.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/guard-destructive.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/guard-untrusted-repo.sh",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/agent-routing.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/read-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/write-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*|mcp__chrome-devtools__.*|.*Claude_Browser.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/browser-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/answer-gate.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "defaultShell": "bash",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "humanizer@humanizer": true,
    "watch@claude-watch": true,
    "stripe@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "claude-watch": {
      "source": {
        "source": "github",
        "repo": "taoufik123-collab/claude-watch"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Read-only git and GitHub inspection: git status/log/diff/show/branch, gh pr view/checks/list, gh run view/list"
    ]
  },
  "agentPushNotifEnabled": true
}
